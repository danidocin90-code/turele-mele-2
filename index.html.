

<!DOCTYPE html>

<html lang="ro">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Turele mele</title>

<style>

*{box-sizing:border-box}

body{margin:0;padding:16px;background:#0b1220;color:#eef4ff;font:16px system-ui}

h1{margin:8px 0}p{color:#a9b9cf}

section{background:#142033;border:1px solid #2b3c55;border-radius:16px;padding:14px;margin:14px 0}

button,select,input,textarea{font:inherit;color:#eef4ff;background:#20314a;border:1px solid #3b506d;border-radius:9px;padding:10px}

button{cursor:pointer}button.primary{background:#245f99}

.nav{display:flex;align-items:center;justify-content:space-between;gap:8px}

#month{font-size:19px;font-weight:bold;text-align:center}

.legend{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}

.legend span{padding:6px 9px;border-radius:20px;background:#20314a;font-size:12px}

.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}

.week{text-align:center;color:#a9b9cf;font-size:12px;padding:5px 0}

.day{min-width:0;min-height:85px;background:#101a2a;border:1px solid #2a3b53;border-radius:8px;padding:4px;overflow:hidden}

.day button{width:100%;height:100%;min-height:75px;padding:3px;border:0;background:transparent;text-align:left}

.day.out{opacity:.35}.day.weekend{background:#192338}

.num{font-weight:bold}.shift{display:block;font-size:11px;font-weight:bold;margin-top:7px;padding:4px 2px;border-radius:5px;overflow-wrap:anywhere}

.zi{background:#62451f;color:#ffdb9c}.noapte{background:#1d4776;color:#b9dcff}.liber{background:#17473b;color:#a4f4d3}.concediu{background:#4c326d;color:#e2caff}.altul{background:#61353b;color:#ffd0d0}

.holiday{display:block;color:#e2baff;font-size:10px;margin-top:4px;overflow-wrap:anywhere}

.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}

.stat{background:#1b2b41;padding:12px;border-radius:10px}.stat b{font-size:24px;display:block}

label{display:block;color:#a9b9cf;font-size:13px;margin:10px 0 5px}

input,select,textarea{width:100%}

.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1}

#editor[hidden]{display:none}

.small{font-size:12px;color:#a9b9cf}

</style>

</head>

<body>

<h1>📅 Turele mele</h1>

<p>Ture automate, libere, concediu și sărbători legale.</p>

<section>

<div class="nav">

<button id="prev">❮</button><div id="month"></div><button id="next">❯</button>

</div>

<div class="row" style="margin-top:10px">

<button id="today">Azi</button><button id="export" class="primary">Exportă calendarul</button>

</div>

<div class="legend">

<span>🟠 Zi</span><span>🔵 Noapte</span><span>🟢 Liber</span><span>🟣 Concediu</span><span>Weekend</span><span>Sărbători</span>

</div>

</section>

<section>

<div class="grid" id="weeks"></div>

<div class="grid" id="calendar"></div>

<p class="small">Apasă pe o zi ca să modifici tura.</p>

</section>

<section>

<h3>Rezumatul lunii</h3>

<div class="stats">

<div class="stat"><b id="nzi">0</b>Ture de zi</div>

<div class="stat"><b id="nnoapte">0</b>Ture de noapte</div>

<div class="stat"><b id="nliber">0</b>Zile libere</div>

<div class="stat"><b id="nconcediu">0</b>Zile de concediu</div>

</div>

</section>

<section id="editor" hidden>

<h3 id="editTitle">Modifică ziua</h3>

<label for="kind">Tipul zilei</label>

<select id="kind">

<option value="auto">Automat, după ciclu</option>

<option value="zi">Tură de zi</option>

<option value="noapte">Tură de noapte</option>

<option value="liber">Liber</option>

<option value="concediu">Concediu</option>

<option value="altul">Alt serviciu</option>

</select>

<label for="label">Etichetă opțională</label>

<input id="label" placeholder="Ex. schimb de tură">

<label for="note">Notă</label>

<textarea id="note" placeholder="Detalii..."></textarea>

<div class="row" style="margin-top:10px">

<button class="primary" id="save">Salvează</button><button id="close">Închide</button>

</div>

</section>

<section>

<h3>Setări program</h3>

<p>Ciclu 12/24 – 12/48: Zi → liber → Noapte → liber.</p>

<label for="anchor">Data de reper</label>

<input id="anchor" type="date" value="2026-11-01">

<label for="anchorKind">Tura în ziua de reper</label>

<select id="anchorKind">

<option value="zi">Zi</option><option value="noapte">Noapte</option>

<option value="liber1">Liber după zi</option><option value="liber2">Liber după noapte</option>

</select>

<button id="settings" class="primary" style="margin-top:10px">Salvează reperul</button>

<button id="clear" style="margin-top:10px">Șterge modificările manuale</button>

<p class="small">Modificările sunt salvate în browserul acestui dispozitiv. Exportă periodic o copie a calendarului.</p>

</section>

<section>

<h3>Sărbători legale din România</h3>

<div id="holidayList"></div>

<p class="small">Sărbătorile sunt marcate separat; nu schimbă automat turele. Verifică lista cu legislația aplicabilă anului respectiv.</p>

</section>

<script>

const $=id=>document.getElementById(id);

const months=['Ianuarie','Februarie','Martie','Aprilie','Mai','Iunie','Iulie','August','Septembrie','Octombrie','Noiembrie','Decembrie'];

const weekdays=['Lun','Mar','Mie','Joi','Vin','Sâm','Dum'];

let view=new Date();view=new Date(view.getFullYear(),view.getMonth(),1);

let chosen=null;

let data={anchor:'2026-11-01',anchorKind:'zi',overrides:{},labels:{},notes:{}};

try{data={...data,...JSON.parse(localStorage.getItem('tureleMele')||'{}')}}catch(e){}

function persist(){try{localStorage.setItem('tureleMele',JSON.stringify(data))}catch(e){alert('Salvarea locală nu este disponibilă. Exportă calendarul.');}}

function iso(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}

function date(s){let [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)}

function plus(d,n){let x=new Date(d);x.setDate(x.getDate()+n);return x}

function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

function easter(y){

 let a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),mo=Math.floor((h+l-7*m+114)/31),day=(h+l-7*m+114)%31+1;

 return new Date(y,mo-1,day)

}

function holidays(y){

 let h={};

 function add(d,n){h[iso(d)]=n}

 [[1,1,'Anul Nou'],[1,2,'A doua zi de Anul Nou'],[1,6,'Boboteaza'],[1,7,'Sf. Ioan'],[1,24,'Unirea Principatelor'],[5,1,'Ziua Muncii'],[6,1,'Ziua Copilului'],[8,15,'Adormirea Maicii Domnului'],[11,30,'Sf. Andrei'],[12,1,'Ziua Națională'],[12,25,'Crăciun'],[12,26,'A doua zi de Crăciun']].forEach(x=>add(new Date(y,x[0]-1,x[1]),x[2]));

 let e=easter(y);add(plus(e,-2),'Vinerea Mare');add(e,'Paștele');add(plus(e,1),'A doua zi de Paște');add(plus(e,49),'Rusalii');add(plus(e,50),'A doua zi de Rusalii');

 return h

}

let holidayCache={};

function hs(y){return holidayCache[y]||(holidayCache[y]=holidays(y))}

function automatic(d){

 let a=date(data.anchor||'2026-11-01'),delta=Math.round((d-a)/86400000);

 let p=((delta%4)+4)%4;

 p=(p+({zi:0,noapte:2,liber1:1,liber2:3}[data.anchorKind]||0))%4;

 return ['zi','liber','noapte','liber'][p]

}

function shift(d){return data.overrides[iso(d)]||automatic(d)}

function titleShift(s,k){return data.labels[k]||({zi:'ZI',noapte:'NOAPTE',liber:'LIBER',concediu:'CONCEDIU',altul:'ALTUL'}[s]||s)}

function render(){

 $('month').textContent=months[view.getMonth()]+' '+view.getFullYear();

 $('weeks').innerHTML=weekdays.map(w=>'<div class="week">'+w+'</div>').join('');

 let first=new Date(view.getFullYear(),view.getMonth(),1),start=plus(first,-((first.getDay()+6)%7)),html='';

 for(let i=0;i<42;i++){

  let d=plus(start,i),k=iso(d),s=shift(d),h=hs(d.getFullYear())[k],weekend=d.getDay()===0||d.getDay()===6;

  html+='<div class="day '+(d.getMonth()!=view.getMonth()?'out ':'')+(weekend?'weekend':'')+'"><button data-date="'+k+'"><span class="num">'+d.getDate()+'</span><span class="shift '+s+'">'+esc(titleShift(s,k))+'</span>'+(h?'<span class="holiday">★ '+esc(h)+'</span>':'')+(data.notes[k]?'<span class="holiday">✎ '+esc(data.notes[k])+'</span>':'')+'</button></div>';

 }

 $('calendar').innerHTML=html;

 document.querySelectorAll('[data-date]').forEach(b=>b.onclick=()=>edit(b.dataset.date));

 let c={zi:0,noapte:0,liber:0,concediu:0};

 for(let d=new Date(first);d.getMonth()===view.getMonth();d=plus(d,1)){let s=shift(d);if(c[s]!==undefined)c[s]++}

 $('nzi').textContent=c.zi;$('nnoapte').textContent=c.noapte;$('nliber').textContent=c.liber;$('nconcediu').textContent=c.concediu;

 $('holidayList').innerHTML=Object.entries(hs(view.getFullYear())).sort().map(([d,n])=>'<p>'+d.slice(8)+'.'+d.slice(5,7)+' — '+esc(n)+'</p>').join('');

}

function edit(k){

 chosen=k;let d=date(k);

 $('editTitle').textContent=d.getDate()+' '+months[d.getMonth()]+' '+d.getFullYear();

 $('kind').value=data.overrides[k]||'auto';$('label').value=data.labels[k]||'';$('note').value=data.notes[k]||'';

 $('editor').hidden=false;$('editor').scrollIntoView({behavior:'smooth'});

}

$('save').onclick=()=>{

 if(!chosen)return;

 if($('kind').value==='auto')delete data.overrides[chosen];else data.overrides[chosen]=$('kind').value;

 if($('label').value.trim())data.labels[chosen]=$('label').value.trim();else delete data.labels[chosen];

 if($('note').value.trim())data.notes[chosen]=$('note').value.trim();else delete data.notes[chosen];

 persist();$('editor').hidden=true;render()

};

$('close').onclick=()=> $('editor').hidden=true;

$('prev').onclick=()=>{view=new Date(view.getFullYear(),view.getMonth()-1,1);render()};

$('next').onclick=()=>{view=new Date(view.getFullYear(),view.getMonth()+1,1);render()};

$('today').onclick=()=>{view=new Date(new Date().getFullYear(),new Date().getMonth(),1);render()};

$('anchor').value=data.anchor;$('anchorKind').value=data.anchorKind;

$('settings').onclick=()=>{data.anchor=$('anchor').value;data.anchorKind=$('anchorKind').value;persist();render();alert('Reper salvat!')};

$('clear').onclick=()=>{if(confirm('Ștergi toate modificările manuale?')){data.overrides={};data.labels={};data.notes={};persist();render()}};

$('export').onclick=()=>{

 let events=[];

 let first=new Date(view.getFullYear(),view.getMonth(),1),end=new Date(view.getFullYear(),view.getMonth()+1,1);

 for(let d=new Date(first);d<end;d=plus(d,1)){

  let k=iso(d),s=shift(d),h=hs(d.getFullYear())[k],n=data.notes[k]||'';

  if(s==='liber'&&!h&&!n)continue;

  let next=iso(plus(d,1)).replaceAll('-',''),summary=titleShift(s,k)+(h?' - '+h:'')+(n?' - '+n:'');

  events.push('BEGIN:VEVENT\r\nUID:'+k+'@turelemele\r\nDTSTART;VALUE=DATE:'+k.replaceAll('-','')+'\r\nDTEND;VALUE=DATE:'+next+'\r\nSUMMARY:'+summary.replace(/[,;]/g,' ')+'\r\nEND:VEVENT')

 }

 let blob=new Blob(['BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Turele mele//RO\r\n'+events.join('\r\n')+'\r\nEND:VCALENDAR'],{type:'text/calendar'});

 let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='turele-mele.ics';a.click();URL.revokeObjectURL(a.href)

};

render();

</script>

</body>

</html>